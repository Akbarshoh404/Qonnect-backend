FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=true

# Security
SECRET_KEY=your-very-long-secret-key-change-this-in-production
ENCRYPTION_KEY=your-fernet-key-run-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key

# Database
DATABASE_URL=sqlite:///qonnect.db

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# App
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DEFAULT_DOMAIN=localhost:5173

# File uploads (bytes, default 50MB)
MAX_FILE_SIZE=52428800

# GeoIP database path (optional, download from MaxMind)
GEOIP_DB_PATH=

# Analytics retention in days
ANALYTICS_RETENTION_DAYS=365
