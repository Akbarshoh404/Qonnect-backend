# =============================================================================
# Qonnect Backend — Production Environment Variables
# Copy this to .env and fill in real values before deploying
# =============================================================================

FLASK_ENV=production
FLASK_DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_STRONG_RANDOM_KEY

# SQLite (file path relative to backend dir) — or use PostgreSQL URL for cloud
DATABASE_URL=sqlite:///qonnect.db

# --- Google OAuth ---
# Must match exactly what's in Google Cloud Console → Authorized redirect URIs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Production callback goes directly to the BACKEND domain
GOOGLE_REDIRECT_URI=https://qonnect-api.akbarshoh-dev.uz/api/auth/callback

# --- App URLs ---
FRONTEND_URL=https://qonnect.akbarshoh-dev.uz
APP_BASE_URL=https://qonnect.akbarshoh-dev.uz
DEFAULT_DOMAIN=qonnect.akbarshoh-dev.uz

# --- Encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# --- Admin Dashboard ---
# Set a strong secret — access /admin with this as X-Admin-Secret header
ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET

# --- Optional ---
ANALYTICS_RETENTION_DAYS=365
MAX_FILE_SIZE=52428800
